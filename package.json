{
  "name": "promix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render-cursor": "remotion render src/index.ts CursorProductFilm out/cursor-product-film.mp4",
    "still-cursor": "remotion still src/index.ts CursorProductFilm out/cursor-product-film.png --frame=300",
    "generate": "node generator/generate.js",
    "ai-generate": "node generator/ai-generate.js",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "server": "node web/server.mjs",
    "dev": "node web/server.mjs & vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@remotion/player": "4.0.526",
    "express": "^5.2.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.526",
    "vite": "7.1.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.526",
    "@types/node": "24.5.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.2"
  }
}
